{
	"name": "fidari-harper-pilot",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"agent:run": "npx -y @harperfast/agent@latest",
		"agent:skills:update": "npx -y skills@latest add harperfast/skills --all --yes",
		"start": "harper run .",
		"dev": "harper dev .",
		"docker:up": "docker compose up --build -d",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "node --test test/*.test.js",
		"test:watch": "node --watch --test test/*.test.js",
		"deploy": "harper deploy restart=true replicated=true",
		"deploy:ref": "harper deploy by_ref=true restart=true replicated=true",
		"deploy:setup": "harper deploy setup=true"
	},
	"dependencies": {
		"@harperfast/schema-codegen": "^2.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.0.2",
		"globals": "^17.4.0",
		"prettier": "^3.8.1"
	}
}
